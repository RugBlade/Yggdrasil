+
+
+def test_23_migrated_internal_utterance_translation_falls_back_read_only(tmp_path: Path):
+    n=_n(tmp_path)
+    n.set_owner_communication_control("internal_utterance_visibility",True)
+    n.set_owner_communication_control("internal_utterance_translation",True)
+    st=n.state.cognition.language
+    # Simulate the exact live H6 edge: a preserved pre-v0.8.2 interaction
+    # utterance exists, while the new source/translation cache fields are empty.
+    st.last_interaction_native_utterance=NativeUtterance(native_text="I am yggdrasil.")
+    st.last_internal_utterance_source=""
+    st.last_internal_english_translation=""
+    st.last_communication_audit={}
+    before=st.model_dump(mode="json")
+    obs=n.owner_internal_utterance_observation()
+    after=st.model_dump(mode="json")
+    assert obs["status"]=="available"
+    assert obs["native_text"]=="I am yggdrasil."
+    assert obs["english_translation"]=="I am yggdrasil."
+    assert obs["translation_origin"]=="deterministic-read-only-existing-native-utterance"
+    assert obs["translation_generated_on_read"] is True
+    assert obs["translation_deterministic"] is True
+    assert obs["translation_content_authority"] is False
+    assert obs["translation_egress_audit"]["content_authority"] is False
+    assert obs["translation_egress_audit"]["semantic_truth_authority"] is False
+    assert obs["translation_egress_audit"]["cognitive_memory_authority"] is False
+    assert obs["observation_changes_communication_action"] is False
+    assert obs["communication_authority"] is False
+    assert obs["relationship_authority"] is False
+    assert obs["native_choice_claim"] is False
+    assert before==after
