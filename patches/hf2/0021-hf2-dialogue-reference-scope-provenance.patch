+def _reference_antecedent_eligible(row: Mapping[str, object]) -> bool:
+    """Transparent grammatical filter for nominal/pronominal antecedent inventory.
+
+    The broad copular role is intentionally ``attribute_or_identity``.  We must not
+    discard that role categorically because predicate nominals can still denote an
+    entity.  We may, however, reject the narrower case where the recorded surface
+    is transparently prepositional under the already-programmed function-word
+    grammar.  This is constituent hygiene only, not lexical/POS/world knowledge.
+    """
+    role = str(row.get("role") or "")
+    surface = str(row.get("surface") or row.get("referent") or "").strip()
+    ws = words(surface)
+    return not (role == "attribute_or_identity" and ws and ws[0] in _PREP)
+
