+    def _cache_resolution_turn(self,event,thought,current_structure):
+        """Bind a preview to this admitted turn, never to persistent last_thought.
+
+        This single-turn cache is not serialized, replayed, or consulted by native
+        choice. It contains no new propositions and gives calibration no actuator.
+        """
+        self._hf2_resolution_turn=None
+        if (not event.content.strip() or event.metadata.get('endogenous')
+                or event.metadata.get('nonconversational_observation')
+                or self.state.last_event_id!=event.id
+                or thought.mathematical_provenance.source_event_id!=event.id
+                or thought.kind!=NativeThoughtKind.RESPONSE):
+            return
+        expected=hashlib.sha256(event.content.encode('utf-8')).hexdigest()
+        if current_structure.get('text_sha256')!=expected:
+            return
+        self._hf2_resolution_turn={
+            'event_id':event.id,
+            'turn':int(self.state.conversational_turn),
+            'structure':deepcopy(current_structure),
+            'questions':tuple(thought.question_candidates),
+        }
+
+    def operator_resolution_calibration(self,action:str,*,owner_authenticated:bool=False):
+        """Preview grounded operator calibration content; execute nothing.
+
+        The 0007 endpoint had no speech-act actuator or execution receipt. Content
+        availability cannot stand in for execution. Native-language/transport
+        coupling remains a later milestone, including nonsemantic act execution.
+        """
+        if not owner_authenticated:
+            raise ValueError('authenticated owner authority is required for resolution calibration')
+        action=str(action or '').strip()
+        if action not in RESOLUTION_AFFORDANCES:
+            raise ValueError('unsupported resolution calibration action')
+        with self._lock:
+            audit={
+                'executed':False,'action':action,
+                'status':'calibration-preview-only-actuator-not-connected',
+                'origin':'operator-directed-calibration-not-native-choice',
+                'authenticated_owner':True,
+                'native_choice_claim':False,'relationship_authority':False,
+                'preference_label_authority':False,'content_authority':False,
+                'transport_authority':False,'execution_authority':False,
+                'eligible':False,'candidates':[],
+            }
+            st=self.state.cognition.speech_act_development
+            if st.pending_action:
+                audit['status']='calibration-not-executed-pending-outcome-already-exists'
+                return audit
+            current=getattr(self,'_hf2_resolution_turn',None)
+            if (not current or current['event_id']!=self.state.last_event_id
+                    or current['turn']!=int(self.state.conversational_turn)):
+                audit['status']='calibration-not-executed-no-current-turn-context'
+                return audit
+            exposure=build_operator_resolution_calibration(
+                action=action,authenticated_owner=True,
+                current_structure=current['structure'],
+                existing_question_candidates=current['questions'],
+            )
+            audit.update({
+                'source_event_id':str(current['event_id']),
+                'eligible':bool(exposure.executable),
+                'content_status':exposure.status,
+                'candidates':[{
+                    'act':c.act,'kind':c.kind,'source_id':c.source_id,
+                    'focus_surface':c.focus_surface,'alternatives':list(c.alternatives),
+                    'existing_question':c.existing_question,'source_units':list(c.source_units),
+                } for c in exposure.candidates],
+            })
+            # No execution receipt exists: no counter, pending state, consequence
+            # training, transport, thought persistence, or security checkpoint.
+            return audit
