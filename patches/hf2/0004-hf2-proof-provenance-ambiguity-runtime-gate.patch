     return False
 
 
+def query_target_propositions(
+    rows: Sequence[LogicalProposition],
+    query: LogicalQuery,
+) -> list[LogicalProposition]:
+    """Return proposition target(s) explicitly requested by a proof query.
+
+    This helper exposes the same transparent relation matching used by ``infer`` so
+    downstream proof auditing never reconstructs a WHY target from surface text or
+    a second hidden parser. It supplies no ranking and no truth authority.
+    """
+    if query.kind not in {'exact-proposition', 'why-proposition'}:
+        return []
+    return [
+        p for p in rows
+        if p.subject == query.subject
+        and p.object == query.object
+        and _relation_matches(p.relation, query.relation)
+    ]
+
+
 def _spatial_relation(relation: str) -> bool:
     return str(relation or '').lower() in {'inside','beside','near','under','above','behind','before','after','on','in','at','from','to'}
 
