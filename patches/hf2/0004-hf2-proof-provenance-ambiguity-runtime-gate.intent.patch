+def _current_ambiguity_constraints(
+    structure: Mapping[str,object] | None,
+    irg_parse_audit: Mapping[str,object] | None,
+) -> tuple[AmbiguityConstraint,...]:
+    rows=list(ambiguity_constraints_from_structure(structure))
+    for i,ref in enumerate(list((irg_parse_audit or {}).get('unresolved_references') or [])):
+        rows.append(AmbiguityConstraint(
+            ambiguity_id=f'irg-unresolved-reference-{i}',kind='irg-unresolved-reference',
+            alternatives=tuple(str(x) for x in ((ref.get('candidates') or []) if isinstance(ref,dict) else []) if x),
+            resolved=False,
+        ))
+    return tuple(rows)
