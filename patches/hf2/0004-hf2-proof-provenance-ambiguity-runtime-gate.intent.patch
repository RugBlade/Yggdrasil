+def _logical_provenance_envelopes(
+    rows: Sequence[LogicalProposition],
+    *,
+    origin: str,
+    source_turn: int,
+    post_closure_knot: KnotState | None = None,
+    active_region_ids: Sequence[str] | None = None,
+) -> list[ConversationalPremiseEnvelope]:
+    """Adapt already-created native proof premises into zero-authority provenance.
+
+    This is an audit adapter only. It does not admit rows into cognitive memory or
+    alter their semantic status. Current IRG and DKT-retrieved persistent premises
+    remain distinct provenance classes from bounded dialogue.
+    """
+    out=[]
+    for p in rows:
+        dkt_ids=tuple(str(x) for x in (getattr(p,'source_memory_ids',[]) or []) if x)
+        if not dkt_ids and getattr(p,'source_memory_id',''):
+            dkt_ids=(str(p.source_memory_id),)
+        trace=NativeGeometryTrace(
+            dkt_activation_ids=dkt_ids,
+            egr_region_ids=tuple(str(x) for x in (active_region_ids or []) if x),
+            dkt_support_knot=(post_closure_knot.model_dump(mode='python') if post_closure_knot is not None else None),
+        )
+        out.append(ConversationalPremiseEnvelope(
+            canonical=p.canonical(),subject=p.subject,relation=p.relation,object=p.object,
+            polarity=bool(p.polarity),source_turn=max(0,int(source_turn)),origin=origin,
+            confidence=float(p.confidence),native_trace=trace,
+        ))
+    return out
+
