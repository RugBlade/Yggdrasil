+def _from_canonical(text: str, *, source: str = 'native-inference', confidence: float = 1.0) -> LogicalProposition | None:
+    """Decode this module's own canonical proposition form.
+
+    This is intentionally not a general language parser. It is used only for
+    structured implication edges whose endpoints were first produced by this
+    transparent proposition substrate.
+    """
+    raw = str(text or '').strip()
+    if not raw:
+        return None
+    polarity = True
+    if raw.startswith('not '):
+        polarity = False
+        raw = raw[4:]
+    parts = raw.split('::', 2)
+    if len(parts) != 3:
+        return None
+    subject, relation, obj = parts
+    modality = ''
+    for modal in sorted(_MODAL, key=len, reverse=True):
+        prefix = modal + ' '
+        if subject.startswith(prefix):
+            modality = modal
+            subject = subject[len(prefix):]
+            break
+    if not subject or not relation:
+        return None
+    return LogicalProposition(
+        subject=subject, relation=relation, object=obj, polarity=polarity,
+        modality=modality, source=source, confidence=confidence, derived=True,
+    )
+
+
+def _split_copular_query(rest: str) -> tuple[str, str]:
+    """Split a finite copular yes/no surface into subject and predicate.
+
+    The old lazy regex parsed ``the lamp on`` as subject ``the`` and predicate
+    ``lamp on``. This mechanical splitter preserves a leading determiner as part of
+    the noun phrase and treats an article immediately before the final token as the
+    predicate article (``Mira a scholar``). No semantic class table participates.
+    """
+    tokens = _clean(rest).split()
+    if len(tokens) < 2:
+        return '', ''
+    if len(tokens) >= 3 and tokens[-2] in {'a','an','the'}:
+        subject_tokens = tokens[:-2]
+        predicate_tokens = tokens[-1:]
+    else:
+        subject_tokens = tokens[:-1]
+        predicate_tokens = tokens[-1:]
+    return _entity(' '.join(subject_tokens)), _entity(' '.join(predicate_tokens))
+
