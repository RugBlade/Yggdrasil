+def native_resolution_sources(
+    structure: Mapping[str, object], existing_questions: Sequence[str] = (),
+) -> tuple[tuple[ResolutionContentCandidate, ...], tuple[ResolutionContentCandidate, ...]]:
+    """Validate native content availability; never choose an act or alternative.
+
+    Only explicit unresolved reference sets supported by the same current parse
+    are admitted in M4C3B. Event-role diagnostic labels are not semantic units.
+    Reject malformed sets as a whole; filtering out a bad member could invent a
+    smaller alternative set. The caller must bind this structure to the event.
+    """
+    refs = structure.get("reference_candidates")
+    ambiguities = structure.get("ambiguities")
+    tokens = structure.get("tokens")
+    valid = []
+    if isinstance(refs, list) and isinstance(ambiguities, list) and isinstance(tokens, list):
+        for raw in ambiguities:
+            if not isinstance(raw, Mapping) or raw.get("kind") != "reference" or raw.get("resolved"):
+                continue
+            if (raw.get("status") != "ambiguous-alternatives-preserved"
+                    or raw.get("authority") != "grammatical-reference-candidate-only"):
+                continue
+            index = raw.get("token_index")
+            focus = raw.get("surface")
+            alternatives = raw.get("candidates")
+            if (type(index) is not int or not 0 <= index < len(tokens)
+                    or not isinstance(focus, str) or not focus.strip()
+                    or tokens[index] != focus
+                    or not isinstance(alternatives, list) or len(alternatives) < 2
+                    or any(not isinstance(x, str) or not x.strip() for x in alternatives)):
+                continue
+            if len(set(x.strip() for x in alternatives)) != len(alternatives):
+                continue
+            keys = ("surface", "token_index", "candidates", "status", "authority")
+            if not any(isinstance(ref, Mapping) and all(ref.get(k) == raw.get(k) for k in keys) for ref in refs):
+                continue
+            # Keep occurrence identity and source order; do not collapse two tokens.
+            valid.append({**{k: raw[k] for k in keys}, "kind": "reference", "id": f"reference-token-{index}"})
+    questions = tuple(q for q in existing_questions if isinstance(q, str) and q.strip())
+    return _clarification_candidates({"ambiguities": valid}), _ask_candidates(questions)
+
+
+def resolution_content_units(candidates, *, action, source_event_id):
+    """Copy already-validated units into native non-propositional content.
+
+    The caller alone owns the native consequence-selection gate. This conversion
+    has no act-selection, truth, reference-resolution or execution authority.
+    """
+    from noeron.cognition.models import NativeResolutionContent
+    return [NativeResolutionContent(
+        act=action, source_event_id=source_event_id, source_id=c.source_id,
+        focus_surface=c.focus_surface, alternatives=list(c.alternatives),
+        existing_question=c.existing_question, source_units=list(c.source_units),
+    ) for c in candidates if c.act == action]
+
+
 def build_resolution_content(
     *,
     selected_action: str | None,
