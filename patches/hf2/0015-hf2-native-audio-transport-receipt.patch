+    def prepare_native_audio_transport(self, presentation: NativePresentationRecord, artifact: RoomArtifactRecord):
+        """Create one process-local capability for a native audio HTTP response.
+
+        Artifact existence/publication is not transport execution.  Only the trusted
+        ASGI adapter may later consume this capability after its send boundary.
+        """
+        if (presentation.audio_artifact_id is None
+                or presentation.audio_artifact_id != artifact.id
+                or presentation.audio_sha256 != artifact.sha256
+                or artifact.direction != 'noeron-to-owner'
+                or not artifact.media_type.startswith('audio/')
+                or not presentation.voice_native_choice_claim):
+            return None
+        token=object()
+        record={
+            'token':token,'presentation_id':presentation.id,'artifact_id':artifact.id,
+            'native_text_sha256':presentation.native_text_sha256,'audio_sha256':artifact.sha256,
+            'audio_size':int(artifact.size),
+        }
+        with self._native_audio_transport_lock:
+            self._native_audio_transports[id(token)]=record
+        return token
+
+    def abandon_native_audio_transport(self, token):
+        if token is None:return
+        with self._native_audio_transport_lock:
+            current=self._native_audio_transports.get(id(token))
+            if current is not None and current.get('token') is token:
+                self._native_audio_transports.pop(id(token),None)
+
