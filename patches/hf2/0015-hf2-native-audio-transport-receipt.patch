+class _NativeAudioRoomResponse(FileResponse):
+    """Trusted server-side receipt at the native-audio ASGI send boundary.
+
+    A completed send is not playback, hearing, understanding, delivery to a person, or
+    reply causation.  Range responses are recorded as range responses rather than being
+    promoted to a full-artifact claim.
+    """
+    def __init__(self,*args,room,transport_token,artifact_size:int,**kwargs):
+        super().__init__(*args,**kwargs)
+        self._room=room;self._transport_token=transport_token;self._artifact_size=int(artifact_size)
+
+    async def __call__(self,scope,receive,send):
+        status=None;response_bytes=0;content_range='';terminal=False;pathsend_used=False
+        async def sent(message):
+            nonlocal status,response_bytes,content_range,terminal,pathsend_used
+            await send(message)
+            typ=message.get('type')
+            if typ=='http.response.start':
+                status=int(message.get('status') or 0)
+                for k,v in message.get('headers',[]):
+                    if bytes(k).lower()==b'content-range':content_range=bytes(v).decode('latin-1')
+            elif typ=='http.response.body':
+                response_bytes+=len(message.get('body',b''))
+                if not message.get('more_body',False):terminal=True
+            elif typ=='http.response.pathsend':
+                pathsend_used=True;response_bytes=self._artifact_size;terminal=True
+        try:
+            await super().__call__(scope,receive,sent)
+            if (scope.get('type')!='http' or scope.get('method','').upper()!='GET'
+                    or not str(scope.get('path') or '').startswith('/room/files/')
+                    or status not in {200,206} or not terminal):
+                self._room.abandon_native_audio_transport(self._transport_token);return
+            await run_in_threadpool(self._room.complete_native_audio_transport,self._transport_token,
+                http_status=status,response_bytes=response_bytes,content_range=content_range,pathsend_used=pathsend_used)
+        except BaseException:
+            self._room.abandon_native_audio_transport(self._transport_token)
+            raise
+
