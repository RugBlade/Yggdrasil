+class NonContentResolutionExecutionReceipt(BaseModel):
+    """Local completion of a non-content resolution act, never peer uptake.
+
+    The receipt proves only that this runtime committed the selected local control
+    action for the current turn. It proves no transport, delivery, reading,
+    understanding, reply causation, relationship meaning, or preference.
+    """
+    receipt_id: UUID = Field(default_factory=uuid4)
+    event_id: UUID
+    turn: int = Field(ge=1)
+    action: Literal['defer', 'remain-silent']
+    channel: Literal['local-runtime-noncontent'] = 'local-runtime-noncontent'
+    status: Literal['local-noncontent-action-committed'] = 'local-noncontent-action-committed'
+    effect: Literal['defer-current-turn-resolution', 'close-current-turn-without-outward-realization']
+    completed_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc))
+    pre_knot_sha256: str = Field(pattern=r'^[a-f0-9]{64}$')
+    pre_residual: float
+    content_emitted: Literal[False] = False
+    outward_transport_performed: Literal[False] = False
+    peer_delivery_confirmed: Literal[False] = False
+    peer_read_confirmed: Literal[False] = False
+    peer_understanding_confirmed: Literal[False] = False
+    peer_reply_causation_confirmed: Literal[False] = False
+
