+    def _commit_noncontent_resolution_execution(self,event):
+        """Commit a selected defer/remain-silent act at a local no-content boundary.
+
+        No message is emitted and no expression action is implied. The receipt proves
+        only that this runtime durably committed the selected control action for this
+        turn. It cannot prove peer delivery, reading, understanding, or reply causation.
+        """
+        st=self.state.cognition.speech_act_development
+        initiative=self.state.cognition.initiative_development
+        action=str(st.last_selected_action or '')
+        base={
+            'receipt_recorded':False,'executed':False,'action':action or None,
+            'content_emitted':False,'outward_transport_performed':False,
+            'peer_delivery_confirmed':False,'peer_read_confirmed':False,
+            'peer_understanding_confirmed':False,'peer_reply_causation_confirmed':False,
+            'learned':False,'relationship_authority':False,'preference_label_authority':False,
+        }
+        if not st.last_native_choice_claim or action not in {'defer','remain-silent'}:
+            return {**base,'status':'native-noncontent-resolution-choice-required'}
+        if (event.kind!=EventKind.USER_MESSAGE or not event.content.strip()
+                or event.id!=self.state.last_event_id
+                or event.metadata.get('endogenous') or event.metadata.get('nonconversational_observation')
+                or event.metadata.get('owner_command') or event.metadata.get('operator_realization_override')):
+            return {**base,'status':'current-ordinary-conversational-event-required'}
+        if (st.pending_action or initiative.pending_expression_pre_knot is not None
+                or getattr(self,'_hf2_resolution_dispatch',None) is not None):
+            return {**base,'status':'pending-or-dispatch-conflict'}
+        pre_residual=self._communication_consistency_residual(self.state.math_kernel)
+        if not math.isfinite(pre_residual):
+            return {**base,'status':'nonfinite-pre-execution-residual'}
+        receipt=NonContentResolutionExecutionReceipt(
+            event_id=event.id,turn=int(self.state.conversational_turn),action=action,
+            effect=self._noncontent_resolution_effect(action),
+            pre_knot_sha256=self._resolution_knot_digest(self.state.math_kernel.dkt.core_knot),
+            pre_residual=pre_residual,
+        )
+        before_speech=st.model_copy(deep=True)
+        checkpoint=self.security.restore()
+        try:
+            self._hf2_receipt_to_mark=receipt
+            marked=self._mark_speech_act_pending(
+                action,event.id,'learned-deliberative',
+                'native-resolution-local-noncontent-completed',execution_receipt=receipt,
+            )
+            if not marked['pending']:
+                raise RuntimeError('verified local non-content execution could not mark outcome')
+            st.last_audit['execution_receipt']=receipt.model_dump(mode='json')
+            self.security.checkpoint(self.state)
+            self.store.append_state(self.state)
+        except BaseException:
+            self.state.cognition.speech_act_development=before_speech
+            self.security.checkpoint(checkpoint)
+            raise
+        finally:
+            self._hf2_receipt_to_mark=None
+        return {
+            **base,'receipt_recorded':True,'executed':True,'status':receipt.status,
+            'receipt_id':str(receipt.receipt_id),'effect':receipt.effect,
+        }
