+    def operator_resolution_calibration(self,action:str,*,owner_authenticated:bool=False):
+        """Execute one explicit authenticated operator calibration exposure.
+
+        The operator chooses the actuator for calibration. The content is read
+        only from current structured/native state. This is never a native-choice,
+        preference, relationship, truth, or answer claim.
+        """
+        if not owner_authenticated:
+            raise ValueError('authenticated owner authority is required for resolution calibration')
+        with self._lock:
+            st=self.state.cognition.speech_act_development
+            if st.pending_action:
+                return {
+                    'executed':False,'action':action,
+                    'status':'calibration-not-executed-pending-outcome-already-exists',
+                    'origin':'operator-directed-calibration-not-native-choice',
+                    'native_choice_claim':False,'relationship_authority':False,
+                    'preference_label_authority':False,
+                }
+            lang=self.state.cognition.language
+            raw=getattr(lang.dialogue,'last_structure',None)
+            if hasattr(raw,'model_dump'):
+                structure=raw.model_dump(mode='json')
+            elif isinstance(raw,dict):
+                structure=dict(raw)
+            else:
+                structure={}
+            thought=self.state.cognition.last_thought
+            questions=list(getattr(thought,'question_candidates',[]) or [])
+            exposure=build_operator_resolution_calibration(
+                action=action,authenticated_owner=True,
+                current_structure=structure,
+                existing_question_candidates=questions,
+            )
+            audit={
+                'executed':bool(exposure.executable),
+                'action':exposure.action,
+                'status':exposure.status,
+                'origin':exposure.origin,
+                'authenticated_owner':True,
+                'native_choice_claim':False,
+                'relationship_authority':False,
+                'preference_label_authority':False,
+                'content_authority':False,
+                'transport_authority':False,
+                'candidates':[{
+                    'act':c.act,'kind':c.kind,'source_id':c.source_id,
+                    'focus_surface':c.focus_surface,'alternatives':list(c.alternatives),
+                    'existing_question':c.existing_question,'source_units':list(c.source_units),
+                } for c in exposure.candidates],
+            }
+            if not exposure.executable:
+                return audit
+            # The exposure above is the calibration actuator. Only after it has
+            # actually produced its grounded/nonsemantic result do we mark the
+            # pre-state for a later observed environmental consequence.
+            st.operator_calibration_observations=int(st.operator_calibration_observations)+1
+            audit['pending']=self._mark_speech_act_pending(
+                exposure.action,
+                decision_layer='operator-directed-calibration-not-native-choice',
+                origin='authenticated-owner-resolution-calibration',
+            )
+            self.security.checkpoint(self.state);self.store.append_state(self.state)
+            return audit
+
