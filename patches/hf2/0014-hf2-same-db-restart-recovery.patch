+    def recovery_state_after_consumed_resolution_receipt(self,receipt_id:str):
+        """Return the newest prior valid state after this receipt was consumed.
+
+        State-history inspection here is restart-integrity provenance only.  It is not
+        cognitive retrieval and grants no semantic, preference, relationship, source,
+        or deployment authority.  The newest row is deliberately excluded because the
+        caller is validating that row as a possible replay.
+        """
+        rid=str(receipt_id or '')
+        if not rid:return None
+        with self._lock:
+            rows=self._connection.execute('SELECT payload FROM states ORDER BY sequence DESC').fetchall()
+        candidate=None
+        for row in rows[1:]:
+            try:state=NoeronState.model_validate_json(row[0])
+            except Exception:continue
+            speech=state.cognition.speech_act_development
+            pending=speech.pending_execution_receipt
+            if candidate is None and (pending is None or str(pending.receipt_id)!=rid):
+                candidate=state
+            audit=dict(speech.last_outcome_audit or {})
+            used=audit.get('execution_receipt')
+            if (isinstance(used,dict) and str(used.get('receipt_id') or '')==rid
+                    and not speech.pending_action and speech.pending_execution_receipt is None):
+                return (candidate or state).model_copy(deep=True)
+        return None
 
